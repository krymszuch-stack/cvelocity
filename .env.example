# .env.example
# ==========================================
# SKILLVAULT - KONFIGURACJA ŚRODOWISKA
# ==========================================

# 1. API AI (Wymagane do działania generatora i doradcy)
GEMINI_API_KEY=twoj_klucz_gemini

# ==========================================
# 2. LOGOWANIE GOOGLE (Firebase Authentication)
# ==========================================
# Z konsoli Firebase (Project Settings -> General -> Your apps -> Web app).
# Bez tych zmiennych logowanie Google pokaże błąd i sprowadzi się do fallbacku e-mail/hasło.
VITE_FIREBASE_API_KEY=twoj_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=twoj-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=twoj-projekt
VITE_FIREBASE_STORAGE_BUCKET=twoj-projekt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=twoj_sender_id
VITE_FIREBASE_APP_ID=twoj_app_id
VITE_FIREBASE_MEASUREMENT_ID=twoj_measurement_id

# ==========================================
# 3. SERWER
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 4. PŁATNOŚCI STRIPE (w trakcie wdrażania)
# ==========================================
# Klucz publiczny trafia do przeglądarki (prefiks VITE_).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_twoj_klucz
# Poniższe są WYŁĄCZNIE serwerowe - nigdy nie dodawaj im prefiksu VITE_.
STRIPE_SECRET_KEY=sk_test_twoj_klucz
STRIPE_WEBHOOK_SECRET=whsec_twoj_sekret_webhooka
