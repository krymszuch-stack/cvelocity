# .env.example
# ==========================================
# SKILLVAULT - KONFIGURACJA ŚRODOWISKA
# ==========================================

# 1. API AI (Wymagane do działania generatora i doradcy)
GEMINI_API_KEY=twoj_klucz_gemini

# ==========================================
# 2. OAUTH - GOOGLE
# ==========================================
# Frontend potrzebuje Client ID, Backend potrzebuje Secret do weryfikacji
VITE_GOOGLE_CLIENT_ID=twoj_google_client_id
GOOGLE_CLIENT_SECRET=twoj_google_client_secret

# ==========================================
# 3. OAUTH - MICROSOFT (AZURE ENTRA ID)
# ==========================================
VITE_AZURE_CLIENT_ID=twoj_azure_client_id
VITE_AZURE_TENANT_ID=common # "common" dla kont osobistych i firmowych, lub ID Twojego Tenanta
AZURE_CLIENT_SECRET=twoj_azure_client_secret
