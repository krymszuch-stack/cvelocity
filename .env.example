# .env.example
# ==========================================
# CVELOCITY - KONFIGURACJA ŚRODOWISKA
# ==========================================

# 1. API AI (Wymagane do działania generatora i doradcy)
GEMINI_API_KEY=twoj_klucz_gemini

# ==========================================
# 2. BACKEND API
# ==========================================
# Puste = wywołania relatywne (dev: Express serwuje front i API na jednym porcie).
# Produkcja (front na Firebase, API na Render): https://cvelocity-api.onrender.com
# UWAGA: Vite wstawia tę wartość w czasie builda — nie da się jej zmienić po deployu.
VITE_API_BASE_URL=

# Ogranicza, które originy mogą wołać API z przeglądarki (tylko backend, opcjonalne).
# ALLOWED_ORIGINS=https://cvelocity-99a72.web.app,https://cvelocity.oathcry.com,https://cv.oathcry.com

# ==========================================
# 3. LOGOWANIE GOOGLE (Firebase Authentication)
# ==========================================
# Z konsoli Firebase (Project Settings -> General -> Your apps -> Web app).
# Bez tych zmiennych logowanie Google pokaże błąd i sprowadzi się do fallbacku e-mail/hasło.
VITE_FIREBASE_API_KEY=twoj_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=twoj-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=twoj-projekt
VITE_FIREBASE_STORAGE_BUCKET=twoj-projekt.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=twoj_sender_id
VITE_FIREBASE_APP_ID=twoj_app_id
VITE_FIREBASE_MEASUREMENT_ID=twoj_measurement_id

# 4. DODATKOWE USTAWIENIA SERWERA (Opcjonalne)
# ==========================================
# Maksymalna liczba żądań w oknie 15 minut dla endpointów korzystających z Gemini (domyślnie 20).
# RATE_LIMIT_MAX=20
