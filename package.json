{
  "name": "skillvault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build-server/server.cjs",
    "start": "node build-server/server.cjs",
    "clean": "rm -rf dist build-server server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "otpauth": "^9.3.6",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.10",
    "typescript": "~7.0.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
