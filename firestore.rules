rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One vault document per signed-in user, keyed by their Firebase Auth uid.
    // Only that same uid may read or write it — nobody else's account, ever.
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
